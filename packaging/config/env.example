# Copy to /etc/gitea-tor-forge/env and fill in. Loaded by compose via
# `podman compose --env-file`.

POSTGRES_USER=gitea
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=gitea

GITEA_ROOT_URL=http://127.0.0.1:3000/
GITEA_ADMIN_USER=mirror-admin
GITEA_ADMIN_PASSWORD=CHANGEME
GITEA_ADMIN_EMAIL=mirror-admin@localhost

# HMAC secret Gitea signs webhook payloads with; mirror-agent verifies it.
WEBHOOK_SECRET=CHANGEME

# Default destination account for repos with no per-repo policy section
# (see mirror-policy.ini), and the account gh(1) authenticates as for
# github.com auto-create.
GITHUB_OWNER=CHANGEME
GITHUB_VISIBILITY=private

# Used by `gh` inside mirror-agent (gh auth login token) *and* as the
# default section's password unless mirror-policy.ini overrides it.
GH_TOKEN=CHANGEME

# Rootless podman socket for this user, mounted into mirror-agent so it
# can run `podman exec` into the gitea container for one-time admin
# bootstrap. Check with: podman info --format '{{.Host.RemoteSocket.Path}}'
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

MIRROR_POLICY_FILE=/etc/gitea-tor-forge/mirror-policy.ini
MIRROR_SECRETS_DIR=/etc/gitea-tor-forge/secrets
MIRROR_KEYS_DIR=/etc/gitea-tor-forge/keys

# SOCKS port for this stack's own tor sidecar (compose/compose.yaml's
# "tor" service). Only needs to change if something else on this qube
# already holds 9050.
TOR_SOCKS_PORT=9050
